{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/generar-insights",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/bot",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

