# ==============================================================================
# CondorFi UI - Variables de Entorno (Plantilla Pública)
# Duplica este archivo como '.env.local' y completa con tus credenciales.
# NUNCA comitees '.env.local' al repositorio.
# ==============================================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ==============================================================================
# Alertas Push Institucionales (Telegram Bot API)
# ==============================================================================
# Token provisto por @BotFather (ej. 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=tu-bot-token-telegram
# ID de usuario, grupo o canal (ej. -1001234567890 o 987654321)
TELEGRAM_CHAT_ID=tu-chat-id-telegram
