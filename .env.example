# ==============================================================================
# CondorFi - Variables de Entorno (Plantilla Pública)
# Duplica este archivo como '.env' y completa con tus credenciales reales.
# NUNCA comitees el archivo '.env' real al repositorio.
# ==============================================================================

# URL de tu proyecto en Supabase (Settings -> API -> Project URL)
SUPABASE_URL=TU_SUPABASE_URL_AQUI

# Clave de acceso a Supabase (Anon Key o Service Role Key si corre en backend privado)
# Settings -> API -> Project API Keys
SUPABASE_KEY=TU_SUPABASE_KEY_AQUI
